# DriveMesh configuration template.
# Copy to `.env` in the repo root (gitignored) and fill in. NEVER commit real values.
# Every setting is an environment variable with the DRIVEMESH_ prefix; advanced tuning knobs
# not listed here (grace periods, batch sizes) are documented in drivemesh/config.py.
# Precedence: real environment variables (e.g. `source data/dev.env`, Render dashboard) > .env > defaults.
# On Render, set these in the dashboard instead; Render never sees this file (render.yaml lists them).

# --- Environment ------------------------------------------------------------
# dev | test | prod. prod refuses to start if anything in the "prod checklist" below is unsafe.
DRIVEMESH_ENV=dev

# --- Metadata database ------------------------------------------------------
# Local default: SQLite file under data/.
DRIVEMESH_DATABASE_URL=sqlite:///./data/drivemesh.db
# Neon / any Postgres (required in prod; use the *pooled* "-pooler" host from Neon -> Connect):
# DRIVEMESH_DATABASE_URL='postgresql://<user>:<password>@<endpoint>-pooler.<region>.aws.neon.tech/neondb?sslmode=require&channel_binding=require'
# Quote the value: it contains '&'. Create/upgrade tables with: drivemesh init

# --- Encryption keys --------------------------------------------------------
# Generate with: .venv/bin/drivemesh gen-key   (prints "k1:<base64>")
# Keep an OFFLINE copy: if this key is lost, all data is unrecoverable.
# Rotation: add a new key ("k1:...,k2:..."), set ACTIVE_KEY_ID=k2, run `drivemesh rewrap`.
DRIVEMESH_MASTER_KEYS=
DRIVEMESH_ACTIVE_KEY_ID=k1

# --- Web / sessions ---------------------------------------------------------
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"   (>= 32 chars)
DRIVEMESH_SESSION_SECRET=
# Optional separate HS256 key for API access tokens (default: derived from SESSION_SECRET).
# DRIVEMESH_JWT_SECRET=
# Bearer token for GET /metrics (unset = /metrics needs an operator session).
# DRIVEMESH_METRICS_TOKEN=
# Public URL of this instance; the Google OAuth redirect is <this>/accounts/callback/google.
DRIVEMESH_PUBLIC_BASE_URL=http://localhost:8000
# true in prod (cookies only over HTTPS).
DRIVEMESH_SECURE_COOKIES=false
# Lets users link local folders as storage. Must be false in prod.
DRIVEMESH_ALLOW_LOCAL_BACKENDS=true
# DRIVEMESH_LOGIN_RATE_PER_MINUTE=10
# DRIVEMESH_SESSION_DAYS=14
# DRIVEMESH_ACCESS_TOKEN_MINUTES=15
# DRIVEMESH_REFRESH_TOKEN_DAYS=30

# Optional: create an operator account with a password on first start (for hosts without a shell).
# Remove both once the account exists.
# DRIVEMESH_OWNER_USERNAME=owner
# DRIVEMESH_OWNER_PASSWORD=

# --- Google OAuth web client (docs/design/MANUAL_STEPS.md section 2) --------
DRIVEMESH_GOOGLE_CLIENT_ID=
DRIVEMESH_GOOGLE_CLIENT_SECRET=

# --- Data path --------------------------------------------------------------
DRIVEMESH_DEFAULT_RF=2
# DRIVEMESH_CHUNK_SIZE=8388608          # bytes (64 KiB .. 256 MiB)
# DRIVEMESH_MIN_WRITE_REPLICAS=          # unset = all RF replicas must succeed
# DRIVEMESH_INFLIGHT_CHUNKS=4
# DRIVEMESH_MAX_UPLOAD_BYTES=10737418240
# DRIVEMESH_FREE_SPACE_RESERVE=268435456

# --- Per-account limits and retries -----------------------------------------
# DRIVEMESH_ACCOUNT_CONCURRENCY=4
# DRIVEMESH_ACCOUNT_RATE=8.0
# DRIVEMESH_ACCOUNT_BURST=16
# DRIVEMESH_RETRY_MAX_ATTEMPTS=6

# --- Background workers (seconds) -------------------------------------------
# DRIVEMESH_WORKERS_ENABLED=true
# DRIVEMESH_HEALTH_INTERVAL=60
# DRIVEMESH_REPAIR_INTERVAL=30
# DRIVEMESH_SCRUB_INTERVAL=60
# DRIVEMESH_GC_INTERVAL=300
# DRIVEMESH_BACKUP_INTERVAL=900
# DRIVEMESH_BALANCER_INTERVAL=600

# --- Logging ----------------------------------------------------------------
# DRIVEMESH_LOG_LEVEL=INFO
DRIVEMESH_LOG_JSON=false

# --- Prod checklist (what DRIVEMESH_ENV=prod enforces) ----------------------
# SESSION_SECRET >= 32 chars, MASTER_KEYS set, SECURE_COOKIES=true,
# ALLOW_LOCAL_BACKENDS=false, PUBLIC_BASE_URL https://..., DATABASE_URL is Postgres.
