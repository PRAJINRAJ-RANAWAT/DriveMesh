# Copy to .env (gitignored) and fill in. Never commit real values.
DRIVEMESH_ENV=dev
DRIVEMESH_DATABASE_URL=sqlite:///./data/drivemesh.db

# Generate with: drivemesh gen-key   (prints "k1:<base64>")
# Keep an OFFLINE copy: if this key is lost, all data is unrecoverable.
DRIVEMESH_MASTER_KEYS=
DRIVEMESH_ACTIVE_KEY_ID=k1

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
DRIVEMESH_SESSION_SECRET=

# Google OAuth web client (see docs/design/MANUAL_STEPS.md)
DRIVEMESH_GOOGLE_CLIENT_ID=
DRIVEMESH_GOOGLE_CLIENT_SECRET=
DRIVEMESH_PUBLIC_BASE_URL=http://localhost:8000

DRIVEMESH_DEFAULT_RF=2
DRIVEMESH_ALLOW_LOCAL_BACKENDS=true
DRIVEMESH_LOG_JSON=false
